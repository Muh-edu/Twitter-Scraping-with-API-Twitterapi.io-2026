    "# Import semua library yang diperlukan\n",
    "import requests    # Untuk melakukan HTTP request ke API\n",
    "import pandas as pd  # Untuk manipulasi data dan menyimpan CSV\n",
    "import time        # Untuk memberi jeda antar request (menghindari rate limit)\n",
    "import os          # Untuk operasi file (cek, baca, hapus)\n",
    "from datetime import datetime, timedelta  # Untuk memecah rentang tanggal\n",
    "\n",
    "print(\"✅ Semua library berhasil diimport!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-func1",
   "metadata": {},
   "source": [
    "## 🧩 Cell 3 — Fungsi Scraping Utama\n",
    "Fungsi `scrape_tweets()` bertugas mengambil tweet dari API secara bertahap menggunakan cursor pagination."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-scrape-func",
   "metadata": {},
   "outputs": [],
   "source": [
    "def scrape_tweets(api_key, query, limit=1000):\n",
    "    \"\"\"\n",
    "    Mengambil tweet dari TwitterAPI.io menggunakan advanced search.\n",
    "\n",
    "    Parameter:\n",
    "        api_key (str) : API Key dari twitterapi.io\n",
    "        query   (str) : Query pencarian Twitter (bisa pakai operator AND/OR)\n",
    "        limit   (int) : Batas maksimal tweet yang diambil per pemanggilan\n",
    "\n",
    "    Return:\n",
    "        list: Daftar tweet dalam bentuk dictionary\n",
    "    \"\"\"\n",
    "    headers  = {'X-API-Key': api_key}  # Header autentikasi\n",
    "    all_data = []   # Tempat menyimpan semua tweet yang berhasil diambil\n",
    "    cursor   = \"\"   # Cursor untuk pagination (halaman berikutnya)\n",
    "    fetched  = 0    # Counter jumlah tweet yang sudah diambil\n",
    "    delay    = 1    # Jeda (detik) antar request\n",
    "\n",
    "    while fetched < limit:\n",
    "        # Parameter query ke API\n",
    "        params = {\n",
    "            'query'     : query,\n",
    "            'queryType' : 'Latest',  # Ambil tweet terbaru lebih dulu\n",
    "            'cursor'    : cursor\n",
    "        }\n",
    "\n",
    "        try:\n",
    "            # Kirim request ke endpoint advanced search\n",
    "            response = requests.get(\n",
    "                \"https://api.twitterapi.io/twitter/tweet/advanced_search\",\n",
    "                headers=headers,\n",
    "                params=params,\n",
    "                timeout=30  # Timeout 30 detik\n",
    "            )\n",
    "\n",
    "            # Jika response bukan 200 OK, hentikan\n",
    "            if response.status_code != 200:\n",
    "                print(f\"❌ Error: {response.status_code} - {response.text}\")\n",
    "                break\n",
    "\n",
    "            data   = response.json()\n",
    "            tweets = data.get('tweets', [])  # Ambil list tweet dari respons\n",
    "\n",
    "            # Jika tidak ada tweet lagi, berhenti\n",
    "            if not tweets:\n",
    "                print(\"✅ Tidak ada tweet lagi\")\n",
    "                break\n",
    "\n",
    "            all_data.extend(tweets)   # Tambahkan tweet ke list utama\n",
    "            fetched += len(tweets)\n",
    "            print(f\"   Fetched: {fetched}\", end='\\r')  # Update counter di tempat\n",
    "\n",
    "            # Cek apakah masih ada halaman berikutnya\n",
    "            if not data.get('has_next_page'):\n",
    "                break\n",
    "\n",
    "            # Ambil cursor untuk halaman berikutnya\n",
    "            cursor = data.get('next_cursor')\n",
    "            if not cursor:\n",
    "                break\n",
    "\n",
    "            time.sleep(delay)  # Jeda antar request agar tidak kena rate limit\n",
    "\n",
    "        except requests.exceptions.RequestException as e:\n",
    "            # Error koneksi — coba lagi setelah 10 detik\n",
    "            print(f\"⚠️ Connection error: {e}\")\n",
    "            print(\"⏳ Retry dalam 10 detik...\")\n",
    "            time.sleep(10)\n",
    "            continue\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error tidak terduga: {e}\")\n",
    "            break\n",
    "\n",
    "    return all_data"
   ]
  },
