   "source": [
    "## 🧩 Cell 4 — Fungsi Pembantu\n",
    "Berisi fungsi-fungsi utilitas: pemecah rentang tanggal, checkpoint, dan penyimpanan data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-helper-funcs",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────\n",
    "# 📅 PEMECAH RENTANG TANGGAL\n",
    "# ─────────────────────────────────────────────\n",
    "def split_date_range(start_date, end_date, days_per_batch):\n",
    "    \"\"\"\n",
    "    Memecah rentang tanggal besar menjadi batch-batch kecil.\n",
    "    Contoh: 1 Jan – 1 Mar dipecah jadi [(1 Jan, 8 Jan), (8 Jan, 15 Jan), ...]\n",
    "\n",
    "    Parameter:\n",
    "        start_date    (str) : Tanggal awal format 'YYYY-MM-DD'\n",
    "        end_date      (str) : Tanggal akhir format 'YYYY-MM-DD'\n",
    "        days_per_batch (int): Jumlah hari per batch\n",
    "\n",
    "    Return:\n",
    "        list of tuples: [(since_1, until_1), (since_2, until_2), ...]\n",
    "    \"\"\"\n",
    "    start = datetime.strptime(start_date, \"%Y-%m-%d\")\n",
    "    end   = datetime.strptime(end_date,   \"%Y-%m-%d\")\n",
    "\n",
    "    date_ranges = []\n",
    "    current = start\n",
    "\n",
    "    while current < end:\n",
    "        # Tentukan batas akhir batch (tidak melebihi end_date)\n",
    "        next_date = min(current + timedelta(days=days_per_batch), end)\n",
    "        date_ranges.append((\n",
    "            current.strftime(\"%Y-%m-%d\"),\n",
    "            next_date.strftime(\"%Y-%m-%d\")\n",
    "        ))\n",
    "        current = next_date\n",
    "\n",
    "    return date_ranges\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────\n",
    "# 📍 CHECKPOINT — SIMPAN & BACA PROGRESS\n",
    "# ─────────────────────────────────────────────\n",
    "def load_checkpoint(checkpoint_file):\n",
    "    \"\"\"\n",
    "    Membaca nomor periode terakhir yang sudah selesai dari file checkpoint.\n",
    "    Mengembalikan 0 jika file belum ada (mulai dari awal).\n",
    "    \"\"\"\n",
    "    if os.path.exists(checkpoint_file):\n",
    "        with open(checkpoint_file, 'r') as f:\n",
    "            content = f.read().strip()\n",
    "            if content:\n",
    "                return int(content)  # Kembalikan nomor periode terakhir\n",
    "    return 0  # Default: mulai dari awal\n",
    "\n",
    "\n",
    "def save_checkpoint(checkpoint_file, period_index):\n",
    "    \"\"\"\n",
    "    Menyimpan nomor periode yang baru saja selesai ke file checkpoint.\n",
    "    Digunakan untuk melanjutkan scraping jika terhenti.\n",
    "    \"\"\"\n",
    "    with open(checkpoint_file, 'w') as f:\n",
    "        f.write(str(period_index))\n",
    "    print(f\"📍 Checkpoint saved: Periode {period_index}\")\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────\n",
    "# 💾 SIMPAN DATA SECARA BERTAHAP (INCREMENTAL)\n",
    "# ─────────────────────────────────────────────\n",
    "def save_intermediate_data(tweets, filename):\n",
    "    \"\"\"\n",
    "    Menyimpan tweet baru ke file CSV secara incremental (ditambahkan, bukan ditimpa).\n",
    "    Tweet diurutkan dari terlama ke terbaru berdasarkan created_at.\n",
    "    Jika file sudah ada, data baru digabungkan dan duplikat dihapus.\n",
    "\n",
    "    Parameter:\n",
    "        tweets   (list) : List tweet hasil scraping periode ini\n",
    "        filename (str)  : Path file CSV output\n",
    "    \"\"\"\n",
    "    new_df = pd.DataFrame(tweets)  # Konversi list tweet ke DataFrame\n",
    "\n",
    "    if len(new_df) > 0:\n",
    "        # API mengembalikan tweet dari BARU ke LAMA\n",
    "        # Kita balik agar urutan jadi LAMA ke BARU\n",
    "        new_df = new_df.iloc[::-1].reset_index(drop=True)\n",
    "\n",
    "        # Verifikasi urutan dengan sort berdasarkan kolom created_at\n",
    "        if 'created_at' in new_df.columns:\n",
    "            try:\n",
    "                # Parse tanggal dari format Twitter: 'Mon Jan 01 12:00:00 +0000 2024'\n",
    "                new_df['created_at_parsed'] = pd.to_datetime(\n",
    "                    new_df['created_at'],\n",
    "                    format='%a %b %d %H:%M:%S %z %Y',\n",
    "                    errors='coerce'\n",
    "                )\n",
    "                # Sort ascending = terlama dulu\n",
    "                new_df = new_df.sort_values('created_at_parsed', ascending=True).reset_index(drop=True)\n",
    "                new_df = new_df.drop('created_at_parsed', axis=1)  # Hapus kolom bantu\n",
    "\n",
    "                # Tampilkan rentang tanggal tweet yang baru disimpan\n",
    "                first_date = new_df['created_at'].iloc[0]\n",
    "                last_date  = new_df['created_at'].iloc[-1]\n",
    "                print(f\"   📅 Sorted: {first_date[:16]} → {last_date[:16]}\")\n",
    "            except Exception as e:\n",
    "                print(f\"   ⚠️ Sort warning: {e}\")\n",
    "\n",
    "    # Gabungkan dengan data sebelumnya jika file sudah ada\n",
    "    if os.path.exists(filename):\n",
    "        existing_df = pd.read_csv(filename, sep=';', encoding='utf-8-sig')\n",
    "        combined_df = pd.concat([existing_df, new_df], ignore_index=True)\n",
    "        # Hapus duplikat berdasarkan ID tweet\n",
    "        combined_df = combined_df.drop_duplicates(subset=['id'], keep='first')\n",
    "        combined_df.to_csv(filename, index=False, encoding='utf-8-sig', sep=';')\n",
    "    else:\n",
    "        # Jika file belum ada, buat baru\n",
    "        new_df.to_csv(filename, index=False, encoding='utf-8-sig', sep=';')\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────\n",
    "# 📦 BACKUP & INFO CHECKPOINT\n",
    "# ─────────────────────────────────────────────\n",
    "def backup_files():\n",
    "    \"\"\"\n",
    "    Mendownload file CSV dan checkpoint ke komputer lokal.\n",
    "    Hanya berfungsi di Google Colab.\n",
    "    \"\"\"\n",
    "    print(\"\\n📦 Membuat backup...\")\n",
    "    try:\n",
    "        from google.colab import files\n",
    "\n",
    "        # Download file CSV hasil scraping\n",
    "        if os.path.exists(FILENAME):\n",
    "            files.download(FILENAME)\n",
    "            print(f\"✅ CSV downloaded: {FILENAME}\")\n",
    "\n",
    "        # Download file checkpoint\n",
    "        if os.path.exists(CHECKPOINT_FILE):\n",
    "            files.download(CHECKPOINT_FILE)\n",
    "            print(f\"✅ Checkpoint downloaded: {CHECKPOINT_FILE}\")\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ Backup gagal: {e}\")\n",
    "        print(\"💡 Anda bisa download manual dari sidebar Colab\")\n",
    "\n",
    "\n",
    "def show_checkpoint_info():\n",
    "    \"\"\"\n",
    "    Menampilkan informasi checkpoint saat ini dan cara mengaksesnya.\n",
    "    Berguna setelah scraping terhenti untuk memastikan progress tersimpan.\n",
    "    \"\"\"\n",
    "    if os.path.exists(CHECKPOINT_FILE):\n",
    "        last_period = load_checkpoint(CHECKPOINT_FILE)\n",
    "        print(f\"\\n📍 CHECKPOINT INFO:\")\n",
    "        print(f\"   Last completed period : {last_period}\")\n",
    "        print(f\"   File location         : /content/{CHECKPOINT_FILE}\")\n",
    "        print(f\"\\n💡 CARA AKSES CHECKPOINT:\")\n",
    "        print(f\"   1. Sidebar kiri Colab → 📁 Files\")\n",
    "        print(f\"   2. Cari file: {CHECKPOINT_FILE}\")\n",
    "        print(f\"   3. Klik kanan → Download\")\n",
    "        print(f\"   4. Atau jalankan: !cat {CHECKPOINT_FILE}\")\n",
    "    else:\n",
    "        print(\"⚠️ Checkpoint file belum ada\")\n",
    "\n",
    "print(\"✅ Semua fungsi pembantu berhasil dimuat!\")"
   ]
  },
  {
