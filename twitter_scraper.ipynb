   "id": "cell-md-main",
   "metadata": {},
   "source": [
    "## 🚀 Cell 5 — Fungsi Utama: Scrape dengan Auto-Resume\n",
    "Fungsi `scrape_with_resume()` adalah orkestrator utama yang menggabungkan semua fungsi di atas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-main-func",
   "metadata": {},
   "outputs": [],
   "source": [
    "def scrape_with_resume(api_key, base_query, start_date, end_date,\n",
    "                       days_per_batch=7, limit_per_period=10000,\n",
    "                       filename='tweets.csv', checkpoint_file='checkpoint.txt'):\n",
    "    \"\"\"\n",
    "    Menjalankan scraping secara penuh dengan fitur resume otomatis.\n",
    "\n",
    "    Alur kerja:\n",
    "      1. Pecah rentang tanggal menjadi batch kecil\n",
    "      2. Cek checkpoint — lewati periode yang sudah selesai\n",
    "      3. Scrape setiap periode & simpan secara incremental\n",
    "      4. Backup otomatis setiap 10 periode\n",
    "      5. Cleanup checkpoint saat selesai\n",
    "\n",
    "    Parameter:\n",
    "        api_key          (str) : API Key twitterapi.io\n",
    "        base_query       (str) : Query dasar tanpa filter tanggal\n",
    "        start_date       (str) : Tanggal mulai 'YYYY-MM-DD'\n",
    "        end_date         (str) : Tanggal selesai 'YYYY-MM-DD'\n",
    "        days_per_batch   (int) : Jumlah hari per batch\n",
    "        limit_per_period (int) : Batas tweet per periode\n",
    "        filename         (str) : Nama file CSV output\n",
    "        checkpoint_file  (str) : Nama file checkpoint\n",
    "\n",
    "    Return:\n",
    "        pd.DataFrame: Data tweet gabungan semua periode\n",
    "    \"\"\"\n",
    "\n",
    "    # Pecah rentang tanggal menjadi batch-batch\n",
    "    date_ranges    = split_date_range(start_date, end_date, days_per_batch)\n",
    "    last_completed = load_checkpoint(checkpoint_file)  # Baca progress terakhir\n",
    "    total_periods  = len(date_ranges)\n",
    "\n",
    "    print(f\"📅 Total periode: {total_periods}\")\n",
    "\n",
    "    if last_completed > 0:\n",
    "        print(f\"🔄 RESUME dari periode {last_completed + 1}\")  # Lanjut dari terakhir\n",
    "    else:\n",
    "        print(f\"🆕 Mulai dari awal\")\n",
    "\n",
    "    # Iterasi setiap batch tanggal\n",
    "    for i, (since, until) in enumerate(date_ranges):\n",
    "\n",
    "        # Lewati periode yang sudah selesai (fitur resume)\n",
    "        if i < last_completed:\n",
    "            continue\n",
    "\n",
    "        # Tambahkan filter tanggal ke query dasar\n",
    "        query = f'{base_query} since:{since} until:{until}'\n",
    "        print(f\"\\n🔄 Periode {i+1}/{total_periods}: {since} → {until}\")\n",
    "\n",
    "        try:\n",
    "            # Jalankan scraping untuk periode ini\n",
    "            tweets = scrape_tweets(api_key, query, limit=limit_per_period)\n",
    "\n",
    "            if tweets:\n",
    "                save_intermediate_data(tweets, filename)  # Simpan ke CSV\n",
    "                print(f\"✅ Berhasil: {len(tweets)} tweets | 💾 Saved!\")\n",
    "                save_checkpoint(checkpoint_file, i + 1)   # Update checkpoint\n",
    "\n",
    "                # Auto backup setiap 10 periode\n",
    "                if (i + 1) % 10 == 0:\n",
    "                    print(f\"\\n📦 Auto backup periode {i+1}...\")\n",
    "                    backup_files()\n",
    "\n",
    "            else:\n",
    "                # Tidak ada tweet di periode ini, tetap update checkpoint\n",
    "                print(\"⚠️ Tidak ada data di periode ini\")\n",
    "                save_checkpoint(checkpoint_file, i + 1)\n",
    "\n",
    "            time.sleep(2)  # Jeda 2 detik antar periode\n",
    "\n",
    "        except KeyboardInterrupt:\n",
    "            # User menghentikan scraping secara manual (Ctrl+C)\n",
    "            print(\"\\n⚠️ Dihentikan oleh user\")\n",
    "            print(f\"💾 Progress tersimpan di periode {i+1}\")\n",
    "            backup_files()\n",
    "            show_checkpoint_info()\n",
    "            print(\"\\n▶️ Jalankan ulang script untuk melanjutkan!\")\n",
    "            break\n",
    "\n",
    "        except Exception as e:\n",
    "            # Error tidak terduga — simpan progress dan hentikan\n",
    "            print(f\"❌ Error di periode {i+1}: {e}\")\n",
    "            print(\"💾 Progress tersimpan, bisa dilanjutkan nanti\")\n",
    "            backup_files()\n",
    "            show_checkpoint_info()\n",
    "            break\n",
    "\n",
    "    # ─── Finalisasi setelah semua periode selesai ───\n",
    "    if os.path.exists(filename):\n",
    "        df = pd.read_csv(filename, sep=';', encoding='utf-8-sig')\n",
    "\n",
    "        # Pastikan tidak ada duplikat di file final\n",
    "        df = df.drop_duplicates(subset=['id'], keep='first')\n",
    "        df.to_csv(filename, index=False, encoding='utf-8-sig', sep=';')\n",
    "\n",
    "        print(f\"\\n✅ SELESAI!\")\n",
    "        print(f\"📊 Total tweets unik: {len(df)}\")\n",
    "        print(f\"📁 File: {filename}\")\n",
    "\n",
    "        # Hapus file checkpoint karena scraping sudah selesai\n",
    "        if os.path.exists(checkpoint_file):\n",
    "            os.remove(checkpoint_file)\n",
    "            print(\"🗑️ Checkpoint dibersihkan (scraping selesai)\")\n",
    "\n",
    "        # Download file final ke komputer lokal\n",
    "        print(\"\\n📥 Download file final...\")\n",
    "        backup_files()\n",
    "\n",
    "        return df\n",
    "    else:\n",
